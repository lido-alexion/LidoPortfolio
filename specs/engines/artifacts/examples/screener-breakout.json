    "factory_key": "breakout_screener",
    "description": "Eligibility filter for near-high breakouts with volume confirmation.",
    "intent": "Find names pressing highs with expanding participation — eligibility only.",
    "summary": "Requires close near 52-week high, positive short-term change, and elevated volume ratio.",
    "tags": ["breakout", "momentum", "eligibility"],
    "category": "momentum",
    "locale": "en",
    "authors": ["StoX Factory"],
    "license": "proprietary",
    "ai": {
      "editable": true,
      "generation_hints": [
        "Prefer existing screenable ids: close, high_52w, change_pct, volume_ratio.",
        "Keep operators in gt|gte|lt|lte|eq."
      ],
      "forbidden_changes": [
        "Do not embed executable code.",
        "Do not invent indicator ids."
      ]
    }
  },
  "definition": {
    "root": {
      "type": "group",
      "op": "AND",
      "children": [
        {
          "type": "condition",
          "left": { "indicator": "close", "params": {} },
          "operator": "gte",
          "weight_factor": 0.95,
          "right": { "indicator": "high_52w", "params": {} }
        },
        {
          "type": "condition",
          "left": {
            "indicator": "change_pct",
            "params": { "period": 5 }
          },
          "operator": "gt",
          "weight_factor": 1.0,
          "right": { "type": "constant", "value": 0 }
        },
        {
          "type": "condition",
          "left": {
            "indicator": "volume_ratio",
            "params": { "period": 20 }
          },
          "operator": "gte",
          "weight_factor": 1.0,
          "right": { "type": "constant", "value": 1.5 }
        },
        {
          "type": "condition",
          "left": {
            "indicator": "price_vs_sma_pct",
            "params": { "period": 50 }
          },
          "operator": "gt",
          "weight_factor": 1.0,
          "right": { "type": "constant", "value": 0 }
        }
      ]
    }
  },
  "dependencies": [
