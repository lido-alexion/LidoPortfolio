[Unit]
Description=StoX live microstructure collector (FEAT-063)
After=network.target

[Service]
Type=simple
User=nitty
Group=www-data
WorkingDirectory=/var/www/stoxla/current/shared/microstructure
Environment=PYTHONUNBUFFERED=1
Environment=STOX_APP_URL=https://stoxla.in
Environment=MICROSTRUCTURE_DATA_ROOT=/var/www/stoxla/shared/storage/app/microstructure
Environment=MICROSTRUCTURE_BACKUP_ROOT=/var/www/stoxla/shared/storage/app/microstructure-backup
Environment=MICROSTRUCTURE_HEARTBEAT_FILE=/var/www/stoxla/shared/storage/app/microstructure/collector-heartbeat.json
Environment=MICROSTRUCTURE_COMMAND_FILE=/var/www/stoxla/shared/storage/app/microstructure/collector-command.json
Environment=MICROSTRUCTURE_FINALIZATION_STATE_FILE=/var/www/stoxla/shared/storage/app/microstructure/finalization-state.json
EnvironmentFile=-/var/www/stoxla/shared/.env.microstructure-collector
ExecStart=/var/www/stoxla/shared/python/microstructure/bin/python -m collector
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
