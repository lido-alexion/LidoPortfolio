####################################### PORTFOLIO APP (Lido Portfolio) START ###############################
# Paste into public_html/.htaccess immediately AFTER "RewriteEngine On".
# Must be ABOVE WordPress / other catch-all rules.

# Apex → www (SSL + session cookies; use one canonical host)
RewriteCond %{HTTP_HOST} ^lidoalexion\.com$ [NC]
RewriteRule ^ https://www.lidoalexion.com%{REQUEST_URI} [R=301,L]

# Diagnostic PHP — never rewrite away from real files
RewriteCond %{REQUEST_URI} ^/portfolio/cpanel-.*\.php$ [NC]
RewriteRule ^ - [L]

# Static diagnostics
RewriteCond %{REQUEST_URI} ^/portfolio/mobile-debug\.html$ [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/portfolio/portfolio-OK\.txt$ [NC]
RewriteRule ^ - [L]

# Any real file under /portfolio/ (build assets, manifest, etc.)
RewriteCond %{REQUEST_URI} ^/portfolio/ [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f
RewriteRule ^ - [L]

# Real directories under /portfolio/
RewriteCond %{REQUEST_URI} ^/portfolio/ [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
RewriteRule ^ - [L]

####################################### PORTFOLIO APP END ###############################
