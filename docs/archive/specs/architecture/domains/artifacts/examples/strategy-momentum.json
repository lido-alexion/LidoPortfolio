{
  "schema_version": "1.0",
  "artifact_type": "strategy",
  "artifact_id": null,
  "slug": "momentum_strategy",
  "name": "Momentum Strategy",
  "artifact_version": 1,
  "definition_hash": null,
  "minimum_engine_version": "1.0.0",
  "metadata": {
    "scope": "system",
    "status": "active",
    "origin": "factory",
    "factory_key": "momentum_factory",
    "description": "Default Minervini-oriented momentum strategy with Trend Template eligibility.",
    "intent": "Trade stage-2 trend names with momentum-weighted scoring and explicit exits.",
    "summary": "Eligibility via Minervini Trend Template Screener reference. Scoring uses Registry composites (relative_strength, momentum_score, trend_score, …). No embedded Screener trees.",
    "tags": ["momentum", "minervini", "factory"],
    "category": "momentum",
    "style": "momentum",
    "holding_horizon": "swing_to_position",
    "risk_profile": "balanced",
    "locale": "en",
    "authors": ["StoX Factory"],
    "license": "proprietary",
    "ai": {
      "editable": true,
      "generation_hints": [
        "Reference screeners by slug or factory_key only.",
        "scoring_model keys must be strategy_scorable Registry ids.",
        "Enabled weights must sum to 100."
      ],
      "forbidden_changes": [
        "Do not embed Screener condition trees.",
        "Do not embed executable code or formulas.",
        "Do not invent indicator keys."
      ]
    }
  },
  "definition": {
    "eligibility_sources": [
      {
        "screener_slug": "minervini_trend_template",
        "screener_factory_key": "minervini_trend_template",
        "min_artifact_version": 1,
        "enabled": true,
        "priority": 1
      }
    ],
    "scoring_model": [
      {
        "key": "relative_strength",
        "enabled": true,
        "weight": 35,
        "minimum": 80,
        "maximum": null,
        "parameters": {
          "lookback_days": 90,
          "benchmark": "NIFTY50"
        }
      },
      {
        "key": "momentum_score",
        "enabled": true,
        "weight": 15,
        "minimum": 70,
        "maximum": null,
        "parameters": {
          "rsi_period": 14
        }
      },
      {
        "key": "trend_score",
        "enabled": true,
        "weight": 20,
        "minimum": 70,
        "maximum": null,
        "parameters": {}
      },
      {
        "key": "breakout_score",
        "enabled": true,
        "weight": 10,
        "minimum": 75,
        "maximum": null,
        "parameters": {}
      },
      {
        "key": "volume_score",
        "enabled": true,
        "weight": 8,
        "minimum": 60,
        "maximum": null,
        "parameters": {}
      },
      {
        "key": "market_regime",
        "enabled": true,
        "weight": 5,
        "minimum": 60,
        "maximum": null,
        "parameters": {}
      },
      {
        "key": "sector_strength",
        "enabled": true,
        "weight": 4,
        "minimum": 60,
        "maximum": null,
        "parameters": {}
      },
      {
        "key": "risk_score",
        "enabled": true,
        "weight": 3,
        "minimum": 0,
        "maximum": 40,
        "parameters": {}
      }
    ],
    "thresholds": {
      "minimum_overall_score": 80,
      "open_position": 85,
      "increase_position": 90,
      "reduce_position": 40,
      "exit_position": 20,
      "watch": 60,
      "very_strong_high": 95,
      "very_strong_low": 15
    },
    "portfolio_rules": {
      "max_position_size_pct": 10,
      "min_position_size_pct": 2,
      "default_position_size_pct": 6,
      "allocation_band_pct": 1,
      "max_cash_deployment_pct": 80,
      "min_cash_reserve_pct": 20,
      "max_new_positions_per_cycle": 5,
      "max_exposure_per_stock_pct": 10
    },
    "capital_allocation": {
      "strategy": "proportional",
      "tie_break": "highest_score",
      "score_bands": [
        { "min": 95, "max": 100, "allocation_pct": 10 },
        { "min": 90, "max": 95, "allocation_pct": 8 },
        { "min": 85, "max": 90, "allocation_pct": 6 },
        { "min": 80, "max": 85, "allocation_pct": 4 },
        { "min": 0, "max": 80, "allocation_pct": 0 }
      ]
    },
    "cash_rules": {
      "reservations_enabled": true,
      "reserve_on_approval": true,
      "release_on_execution": true,
      "release_on_cancellation": true,
      "release_on_expiry": true
    },
    "exit_strategy": {
      "enabled": true,
      "mode": "any",
      "rules": [
        {
          "id": "score_exit",
          "type": "score_below",
          "enabled": true,
          "params": { "threshold_key": "exit_position" }
        },
        {
          "id": "trailing_weakness",
          "type": "score_below",
          "enabled": true,
          "params": { "threshold_key": "reduce_position" }
        }
      ]
    },
    "market_gates": {
      "enabled": false,
      "min_sentiment": 45,
      "allowed_phases": [
        "Strong Bull",
        "Bull",
        "Consolidation",
        "Pullback",
        "Recovery"
      ],
      "max_risk_raw": 70
    },
    "recommendation_behaviour": {
      "allow_increase_position": true,
      "allow_reduce_position": true,
      "allow_partial_exit": true,
      "allow_averaging_up": true,
      "allow_averaging_down": false,
      "max_concurrent_recommendations": 100,
      "expiry_hours": 48,
      "generate_explainability": true,
      "display_factor_breakdown": true,
      "display_indicator_contributions": true,
      "record_strategy_version": true,
      "record_cash_snapshot": true,
      "record_portfolio_snapshot": true
    },
    "risk": {
      "high_atr_pct": 4,
      "medium_atr_pct": 2
    }
  },
  "dependencies": [
    {
      "kind": "uses_screener",
      "artifact_type": "screener",
      "ref": "minervini_trend_template",
      "ref_scheme": "factory_key",
      "min_artifact_version": 1,
      "resolution": "bundle",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "relative_strength",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "momentum_score",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "trend_score",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "breakout_score",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "volume_score",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "market_regime",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "sector_strength",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    },
    {
      "kind": "uses_indicator",
      "artifact_type": "indicator",
      "ref": "risk_score",
      "ref_scheme": "registry_id",
      "resolution": "runtime_registry",
      "required": true
    }
  ],
  "validation": {
    "rules": [
      {
        "code": "STRATEGY_WEIGHTS_SUM_100",
        "path": "$.definition.scoring_model",
        "severity": "error",
        "message": "Enabled scoring weights must sum to 100."
      },
      {
        "code": "STRATEGY_NO_EMBEDDED_SCREENER",
        "path": "$.definition.eligibility_sources",
        "severity": "error",
        "message": "Eligibility must reference Screeners; never embed condition trees."
      },
      {
        "code": "STRATEGY_KEYS_REGISTRY",
        "path": "$.definition.scoring_model",
        "severity": "error",
        "message": "Each scoring key must be a strategy_scorable Registry id."
      }
    ]
  }
}
