{
  "openapi": "3.0.3",
  "info": {
    "title": "StoX Admin log error triage",
    "version": "1.0.0",
    "description": "Admin-only sanitized OPS-003 inspection. No raw logs or secrets. Existing Sanctum authentication and Admin authorization are required."
  },
  "security": [
    {
      "sanctumCookie": []
    }
  ],
  "paths": {
    "/api/admin/log-error-triages": {
      "get": {
        "summary": "List recent sanitized triage decisions and operational status",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "classification",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "code_bug",
                "external_dependency",
                "configuration_or_environment",
                "expected_operational_condition",
                "data_quality_or_input",
                "security_or_abuse_signal",
                "uncertain"
              ]
            }
          },
          {
            "name": "min_confidence",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe operational evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "capability": {
                      "type": "object"
                    },
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "github": {
                      "type": "object"
                    },
                    "confidence_threshold": {
                      "type": "number"
                    },
                    "debounce_seconds": {
                      "type": "integer"
                    },
                    "decision_ttl_seconds": {
                      "type": "integer"
                    },
                    "triages": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Triage"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Record not found"
          },
          "422": {
            "description": "Invalid filters"
          }
        }
      }
    },
    "/api/admin/log-error-triages/{triage}": {
      "get": {
        "summary": "Inspect sanitized triage, decision history and GitHub generation history",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "triage",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe operational evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "triage": {
                      "$ref": "#/components/schemas/Triage"
                    },
                    "decisions": {
                      "type": "object"
                    },
                    "github_binding": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Record not found"
          },
          "422": {
            "description": "Invalid filters"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctumCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session"
      }
    },
    "schemas": {
      "Triage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "signature": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "first_seen_at": {
            "type": "string"
          },
          "last_seen_at": {
            "type": "string"
          },
          "occurrence_count": {
            "type": "integer"
          },
          "classification": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "actionability": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "report_status": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "evidence": {
            "type": "string",
            "nullable": true
          },
          "failure_reason": {
            "type": "string",
            "nullable": true
          },
          "github_issue_number": {
            "type": "integer",
            "nullable": true
          },
          "github_issue_url": {
            "type": "string",
            "nullable": true
          },
          "prompt_version": {
            "type": "integer",
            "nullable": true
          },
          "provider_path": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
