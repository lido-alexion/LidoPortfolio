{
  "openapi": "3.0.3",
  "info": {
    "title": "StoX automatic issue reporting and log triage",
    "version": "1.0.0",
    "description": "Sanitized operational contracts. Admin inspection endpoints require Sanctum authentication and Admin authorization; browser error intake requires Sanctum authentication and rate limiting. No raw browser diagnostic payloads are retained."
  },
  "security": [
    {
      "sanctumCookie": []
    }
  ],
  "paths": {
    "/api/admin/log-error-triages": {
      "get": {
        "summary": "List recent sanitized triage decisions and operational status",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "classification",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "code_bug",
                "external_dependency",
                "configuration_or_environment",
                "expected_operational_condition",
                "data_quality_or_input",
                "security_or_abuse_signal",
                "uncertain"
              ]
            }
          },
          {
            "name": "min_confidence",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe operational evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "capability": {
                      "type": "object"
                    },
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "github": {
                      "type": "object"
                    },
                    "reporting": {
                      "type": "object",
                      "properties": {
                        "api": {
                          "type": "object",
                          "properties": {
                            "enabled": {"type": "boolean"},
                            "token_configured": {"type": "boolean"},
                            "repository_configured": {"type": "boolean"},
                            "repository_matches_expected": {"type": "boolean"},
                            "records_by_sync_status": {"type": "object", "additionalProperties": {"type": "integer"}},
                            "queue_uses_log_triage": {"type": "boolean"},
                            "queue_is_async": {"type": "boolean"},
                            "worker_configuration_status": {"type": "string", "enum": ["unknown_needs_operator_verification"]}
                          }
                        },
                        "log_triage": {
                          "type": "object",
                          "properties": {
                            "enabled": {"type": "boolean"},
                            "queue_uses_log_triage": {"type": "boolean"},
                            "queue_is_async": {"type": "boolean"},
                            "worker_configuration_status": {"type": "string", "enum": ["unknown_needs_operator_verification"]}
                          }
                        }
                      }
                    },
                    "confidence_threshold": {
                      "type": "number"
                    },
                    "debounce_seconds": {
                      "type": "integer"
                    },
                    "decision_ttl_seconds": {
                      "type": "integer"
                    },
                    "triages": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Triage"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Record not found"
          },
          "422": {
            "description": "Invalid filters"
          }
        }
      }
    },
    "/api/admin/log-error-triages/{triage}": {
      "get": {
        "summary": "Inspect sanitized triage, decision history and GitHub generation history",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "triage",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe operational evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "triage": {
                      "$ref": "#/components/schemas/Triage"
                    },
                    "decisions": {
                      "type": "object"
                    },
                    "github_binding": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Record not found"
          },
          "422": {
            "description": "Invalid filters"
          }
        }
      }
    },
    "/api/ops/browser-errors": {
      "post": {
        "summary": "Submit a bounded browser runtime fault",
        "description": "Authenticated and rate-limited per account. Requires no active portfolio. This records a typed untrusted browser observation; it is not an AI code_bug classification or verified PHP evidence. Raw messages, stacks, URLs, query strings, request IDs, build/module/route strings, and user data are not accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {"type": "string", "enum": ["react_render", "uncaught_exception", "unhandled_rejection"]}
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {"description": "Accepted for fail-open local incident handling"},
          "401": {"description": "Authentication required"},
          "422": {"description": "Payload rejected"},
          "413": {"description": "Request body exceeds the bounded payload limit"},
          "429": {"description": "Authenticated caller rate limit exceeded"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctumCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session"
      }
    },
    "schemas": {
      "Triage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "signature": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "first_seen_at": {
            "type": "string"
          },
          "last_seen_at": {
            "type": "string"
          },
          "occurrence_count": {
            "type": "integer"
          },
          "classification": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "actionability": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "report_status": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "evidence": {
            "type": "string",
            "nullable": true
          },
          "failure_reason": {
            "type": "string",
            "nullable": true
          },
          "github_issue_number": {
            "type": "integer",
            "nullable": true
          },
          "github_issue_url": {
            "type": "string",
            "nullable": true
          },
          "prompt_version": {
            "type": "integer",
            "nullable": true
          },
          "provider_path": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
