APP_NAME=LidoPortfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=2
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

NSE_EQUITY_CSV_URL=https://archives.nseindia.com/content/equities/EQUITY_L.csv
BSE_STOCK_MASTER_ENABLED=false
BSE_EQUITY_CSV_URL=
STOCK_REVALIDATION_DAYS=7

DB_CONNECTION=mysql
# MySQL credentials: use config/DBConfig.php (same as Lido Wallets).
# Optional override: absolute path to a shared DBConfig on the server:
# DB_CONFIG_PATH=/home/USER/shared/DBConfig.php
# Or set DB_* here only if you are not using DBConfig.php:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lido_db
# DB_USERNAME=niti_nits
# DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,your-domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=portfolio_jobs
DB_QUEUE_BATCH_TABLE=portfolio_job_batches
QUEUE_FAILED_TABLE=portfolio_failed_jobs

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PORTFOLIO_CRON_TIME=18:30
PORTFOLIO_CRON_TIMEZONE=Asia/Kolkata
# Notification schedules are stored in portfolio_settings (notification_schedules JSON) via Settings UI.

VITE_APP_NAME="${APP_NAME}"

# Path to Mozilla CA bundle for outbound HTTPS (NSE/Yahoo/Telegram). Example on Windows:
# CURL_CAFILE=C:\certs\cacert.pem
CURL_CAFILE=
