APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=2
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

NSE_EQUITY_CSV_URL=https://archives.nseindia.com/content/equities/EQUITY_L.csv
BSE_STOCK_MASTER_ENABLED=false
BSE_EQUITY_CSV_URL=
STOCK_REVALIDATION_DAYS=7

# Universe-wide NSE OHLCV sync (see implementation.md)
UNIVERSE_PRICE_SYNC_ENABLED=true
UNIVERSE_PRICE_SYNC_SCOPE=all_equities
UNIVERSE_PRICE_SYNC_HISTORY_DAYS=365
UNIVERSE_PRICE_SYNC_DAILY_LOOKBACK_DAYS=10
UNIVERSE_PRICE_SYNC_DELAY_MS=400
UNIVERSE_PRICE_SYNC_BATCH_SIZE=75

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lido_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8001,127.0.0.1,127.0.0.1:8001
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Managed yfinance runtime used by YahooFundamentalDataProvider in production.
# Production deployment provisions this under shared storage.
STOXLA_FUNDAMENTALS_PYTHON=/var/www/stoxla/shared/python/fundamentals/bin/python
# Official exchange historical adapters (FEAT-054); disabled until ingest is configured.
FUNDAMENTALS_NSE_OFFICIAL_ENABLED=false
# FUNDAMENTALS_NSE_OFFICIAL_FEED_URL=https://operator-feed.example/nse-fundamentals
FUNDAMENTALS_BSE_OFFICIAL_ENABLED=false
# STOXLA_INTRADAY_BACKFILL_INTERNAL_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# V8 FEAT-055 account access requests (CAPTCHA + verification)
# ACCESS_REQUEST_CAPTCHA_DRIVER=turnstile
# ACCESS_REQUEST_CAPTCHA_DRIVER=testing
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# ACCESS_REQUEST_VERIFICATION_EXPIRY_HOURS=24
# ACCESS_REQUEST_IGNORE_COOLDOWN_HOURS=72

# V8 FEAT-062 fundamental AI insights (deterministic layer always on; LLM optional)
# FUNDAMENTALS_AI_INSIGHTS_ENABLED=false
# FUNDAMENTALS_AI_PRIMARY_PROVIDER=gemini
# FUNDAMENTALS_AI_SECONDARY_PROVIDER=codex
# FUNDAMENTALS_AI_GEMINI_API_KEY=
# FUNDAMENTALS_AI_GEMINI_MODEL=gemini-2.0-flash
# FUNDAMENTALS_AI_CODEX_API_KEY=
# FUNDAMENTALS_AI_CODEX_BASE_URL=https://api.openai.com/v1
# FUNDAMENTALS_AI_CODEX_MODEL=gpt-4o-mini
# FUNDAMENTALS_AI_DAILY_GLOBAL_MAX=500
# FUNDAMENTALS_AI_DAILY_PER_USER_MAX=50
# FUNDAMENTALS_AI_PROMPT_VERSION=fundamental-signals-v1

# V8 FEAT-065 intraday ML historical platform (Mac corpus + checkpoints)
# STOXLA_INTRADAY_PLATFORM_ENABLED=false
# STOXLA_INTRADAY_CORPUS_ROOT=/path/to/shared/intraday/corpus

# V8 FEAT-063 live microstructure collector (VPS)
# MICROSTRUCTURE_COLLECTOR_ENABLED=false
# MICROSTRUCTURE_KITE_USER_ID=
# MICROSTRUCTURE_DATA_ROOT=
# MICROSTRUCTURE_HEARTBEAT_FILE=
# MICROSTRUCTURE_COMMAND_FILE=
# MICROSTRUCTURE_COLLECTOR_INTERNAL_TOKEN=
# MICROSTRUCTURE_RAW_SPOOL_MAX_MB=512
# MICROSTRUCTURE_RAW_SPOOL_MAX_AGE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ML lifecycle automation (V8 FEAT-056). Off by default.
# STOXLA_ML_LIFECYCLE_ENABLED=false
# STOXLA_ML_SCHEDULE_1M_ENABLED=false
# STOXLA_ML_SCHEDULE_3M_ENABLED=false
# STOXLA_ML_SCHEDULE_6M_ENABLED=false
# STOXLA_ML_DRIFT_TRIGGER_ENABLED=false
# STOXLA_ML_LIFECYCLE_NOTIFICATIONS_ENABLED=true
# STOXLA_ML_RETRY_MAX_ATTEMPTS=3
# STOXLA_ML_RECOVERY_STALE_MINUTES=30
# STOXLA_ML_RETENTION_ENABLED=false
# STOXLA_ML_RETENTION_MAX_RETAINED=3
# STOXLA_ML_LIFECYCLE_TIMEZONE=Asia/Kolkata
# HistGradientBoosting challenger candidate registration (V8 FEAT-057). On by default when unset.
# STOXLA_ML_CHALLENGER_CANDIDATES_ENABLED=true
# STOXLA_ML_CHALLENGER_MIN_ROC_AUC_DELTA=0.01

VITE_APP_NAME="${APP_NAME}"
# LidoTelemetry / OpenTelemetry export (V8 FEAT-052). Off by default; enable when Collector endpoint is configured.
# LIDO_TELEMETRY_ENABLED=false
# LIDO_TELEMETRY_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# LIDO_TELEMETRY_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# LIDO_TELEMETRY_SERVICE_NAME=stox
# LIDO_TELEMETRY_ENVIRONMENT=local
# VITE_LIDO_TELEMETRY_ENABLED=false
# VITE_LIDO_TELEMETRY_OTLP_TRACES_ENDPOINT=
# VITE_LIDO_TELEMETRY_SERVICE_NAME=stox
# VITE_LIDO_TELEMETRY_SERVICE_VERSION=v8
# VITE_LIDO_TELEMETRY_ENVIRONMENT=production
# Sidebar shell framework (layout/responsive only). 1/true = on, 0/false = off. Default on if unset.
# VITE_SIDEBAR_SHELL=1

# Zerodha Kite Connect (V4-FEAT-001). Per-user login; never commit real secrets.
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URL="${APP_URL}/api/v1/broker/kite/callback"

# Trading OS unattended pipeline (V4-FEAT-010). Defaults ON when unset.
# TRADING_OS_ENABLED=true
# TRADING_OS_PIPELINE_SCHEDULE=true
# TRADING_OS_PIPELINE_AFTER_SYNC=true
# TRADING_OS_PIPELINE_TIME=19:00
# TRADING_OS_EXECUTION_START=09:15
# TRADING_OS_EXECUTION_CUTOFF=15:30
