# Copy to public_html/lidoportfolio/.env — see deploy/DEPLOY.md for full steps.
# DB credentials: /home/USER/config/DBConfig.php only (no DB_HOST / DB_USER here).

APP_NAME=LidoPortfolio
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://lidoalexion.com/portfolio

# Do NOT set DB_HOST / DB_USERNAME / DB_PASSWORD here — they override shared DBConfig.php.
# Optional — force shared credentials (recommended on GoDaddy):
DB_CONFIG_PATH=/home/p7xatiz6j0mk/config/DBConfig.php

SESSION_DRIVER=database
SESSION_LIFETIME=43200
# Cookie path defaults from APP_URL path (/portfolio). Override only if needed.
# SESSION_PATH=/portfolio
SESSION_DOMAIN=.lidoalexion.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SANCTUM_STATEFUL_DOMAINS=lidoalexion.com,www.lidoalexion.com

QUEUE_CONNECTION=database
DB_QUEUE_TABLE=portfolio_jobs
DB_QUEUE_BATCH_TABLE=portfolio_job_batches
QUEUE_FAILED_TABLE=portfolio_failed_jobs

CACHE_STORE=database

PORTFOLIO_CRON_TIME=18:30
PORTFOLIO_CRON_TIMEZONE=Asia/Kolkata

# Subdirectory deploy — set before npm run build on PC
VITE_APP_BASE=/portfolio/build/

# Outbound HTTPS (NSE/Yahoo/Telegram) on shared hosting:
# CURL_CAFILE=/home/LIDO/cacert.pem
